cmake_minimum_required(VERSION 3.25)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()
set(platform "@CMAKE_SYSTEM_NAME@")
set(search_dirs "@IVY_SEARCH_DIRS@")
set(prefix "@IVY_GLIB_PREFIX@")
set(libdir "@IVY_GLIB_LIBDIR@")
set(datadirs "@IVY_GLIB_DATADIR@" "@IVY_GTK_DATADIR@")
set(templates "@CMAKE_CURRENT_SOURCE_DIR@/cmake")
set(name "ivy-gtk-${platform}-@CMAKE_SYSTEM_PROCESSOR@")
set(dist "@CMAKE_CURRENT_SOURCE_DIR@/dist")
# Only remove our own staging directory, never the user's dist directory.
set(stage "@CMAKE_BINARY_DIR@/bundle-stage/${name}")
file(REMOVE_RECURSE "${stage}")
set(root "${stage}")
if(platform STREQUAL "Darwin")
    set(root "${stage}/Ivy.app/Contents/Resources")
endif()
file(MAKE_DIRECTORY "${root}/bin" "${root}/lib" "${root}/share")
get_filename_component(exe_name "${IVY_EXECUTABLE}" NAME)
file(COPY "${IVY_EXECUTABLE}" DESTINATION "${root}/bin")
set(executables "${IVY_EXECUTABLE}")
set(modules)
set(staged_modules)

# These are loaded with dlopen/LoadLibrary and cannot be discovered by walking
# the executable's import table. Seed the recursive scanner with them as well.
function(copy_modules source relative)
    if(NOT IS_DIRECTORY "${source}")
        return()
    endif()
    file(GLOB libs "${source}/*.dll" "${source}/*.so" "${source}/*.dylib")
    foreach(lib IN LISTS libs)
        file(COPY "${lib}" DESTINATION "${root}/${relative}")
        get_filename_component(base "${lib}" NAME)
        list(APPEND modules "${lib}")
        list(APPEND staged_modules "${root}/${relative}/${base}")
    endforeach()
    set(modules "${modules}" PARENT_SCOPE)
    set(staged_modules "${staged_modules}" PARENT_SCOPE)
endfunction()
copy_modules("${libdir}/gio/modules" "lib/gio/modules")
set(pixbuf_source "@IVY_PIXBUF_MODULEDIR@")
set(pixbuf_relative "lib/gdk-pixbuf-2.0/loaders")
copy_modules("${pixbuf_source}" "${pixbuf_relative}")
# GTK4's print/media backends, if provided by this GTK build.
file(GLOB_RECURSE gtk_modules "${libdir}/gtk-4.0/*.dll"
    "${libdir}/gtk-4.0/*.so" "${libdir}/gtk-4.0/*.dylib")
foreach(module IN LISTS gtk_modules)
    get_filename_component(dir "${module}" DIRECTORY)
    file(RELATIVE_PATH relative "${libdir}" "${dir}")
    copy_modules("${dir}" "lib/${relative}")
endforeach()
list(REMOVE_DUPLICATES modules)
list(REMOVE_DUPLICATES staged_modules)

set(schema_found FALSE)
set(icons_found FALSE)
foreach(data IN LISTS datadirs)
    if(IS_DIRECTORY "${data}/glib-2.0/schemas")
        file(COPY "${data}/glib-2.0/schemas" DESTINATION "${root}/share/glib-2.0"
            FILES_MATCHING PATTERN "*.xml" PATTERN "*.override")
        set(schema_found TRUE)
    endif()
    foreach(theme Adwaita AdwaitaLegacy hicolor)
        if(IS_DIRECTORY "${data}/icons/${theme}")
            file(COPY "${data}/icons/${theme}" DESTINATION "${root}/share/icons")
            if(theme STREQUAL "Adwaita")
                set(icons_found TRUE)
            endif()
        endif()
    endforeach()
    if(IS_DIRECTORY "${data}/licenses")
        file(COPY "${data}/licenses" DESTINATION "${root}/share")
    endif()
endforeach()
if(NOT schema_found OR NOT icons_found)
    message(FATAL_ERROR "GTK schemas or Adwaita icons missing. Install glib schemas and adwaita-icon-theme.")
endif()
find_program(compile_schemas NAMES glib-compile-schemas HINTS "${prefix}/bin" REQUIRED)
execute_process(COMMAND "${compile_schemas}" "${root}/share/glib-2.0/schemas"
    COMMAND_ERROR_IS_FATAL ANY)
if(IS_DIRECTORY "${prefix}/etc/fonts")
    file(COPY "${prefix}/etc/fonts" DESTINATION "${root}/etc")
endif()
# OpenSSL consumers can use these through SSL_CERT_FILE; libcurl is configured
# explicitly by the app's packaged-runtime initializer.
foreach(cert "${prefix}/etc/ssl/cert.pem" "${prefix}/etc/ssl/certs/ca-bundle.crt"
        "${prefix}/share/curl/curl-ca-bundle.crt" "/etc/ssl/certs/ca-certificates.crt")
    if(EXISTS "${cert}")
        file(MAKE_DIRECTORY "${root}/etc/ssl")
        file(COPY_FILE "${cert}" "${root}/etc/ssl/cert.pem")
        break()
    endif()
endforeach()

if(modules)
    find_program(query_loaders NAMES gdk-pixbuf-query-loaders HINTS "${prefix}/bin")
    if(EXISTS "${pixbuf_source}" AND NOT query_loaders)
        message(FATAL_ERROR "gdk-pixbuf-query-loaders is required to relocate image loaders")
    endif()
    if(query_loaders)
        file(COPY "${query_loaders}" DESTINATION "${root}/bin")
        list(APPEND executables "${query_loaders}")
    endif()
endif()

if(platform STREQUAL "Windows")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM windows+pe)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
    set(excludes "api-ms-.*" "ext-ms-.*")
    # Exclude by resolved path, not a hand-maintained list of system DLL names.
    set(post_excludes ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*")
elseif(platform STREQUAL "Linux")
    find_program(patchelf NAMES patchelf REQUIRED)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM linux+elf)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL objdump)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
    # Keep the host's libc/loader and graphics drivers together. Everything else,
    # including GTK, libadwaita and their transitive dependencies, is bundled.
    set(excludes "ld-linux.*" "ld-musl.*" "lib(c|m|pthread|dl|rt|resolv|util|anl)\\.so.*"
        "libnss_.*" "lib(GL|GLX|EGL|GLdispatch|OpenGL|vulkan)\\.so.*"
        "lib(GLX|EGL)_.*" "libdrm.*")
    set(post_excludes)
elseif(platform STREQUAL "Darwin")
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM macos+macho)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL otool)
    find_program(otool NAMES otool REQUIRED)
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${otool}")
    set(excludes "^/System/Library/" "^/usr/lib/")
    set(post_excludes "^/System/Library/" "^/usr/lib/")
else()
    message(FATAL_ERROR "Unsupported packaging platform: ${platform}")
endif()
file(GET_RUNTIME_DEPENDENCIES EXECUTABLES ${executables} MODULES ${modules}
    DIRECTORIES ${search_dirs}
    PRE_EXCLUDE_REGEXES ${excludes} POST_EXCLUDE_REGEXES ${post_excludes}
    RESOLVED_DEPENDENCIES_VAR resolved UNRESOLVED_DEPENDENCIES_VAR unresolved
    CONFLICTING_DEPENDENCIES_PREFIX conflicts)
if(unresolved OR conflicts_FILENAMES)
    message(FATAL_ERROR "Runtime dependencies unresolved: ${unresolved}; conflicts: ${conflicts_FILENAMES}")
endif()
set(library_dest "${root}/lib")
if(platform STREQUAL "Windows")
    set(library_dest "${root}/bin")
endif()
foreach(lib IN LISTS resolved)
    file(COPY "${lib}" DESTINATION "${library_dest}" FOLLOW_SYMLINK_CHAIN)
endforeach()
file(WRITE "${root}/DEPENDENCIES.txt" "Platform: ${platform}\nArchitecture: @CMAKE_SYSTEM_PROCESSOR@\n")
foreach(lib IN LISTS resolved modules)
    file(SHA256 "${lib}" hash)
    file(APPEND "${root}/DEPENDENCIES.txt" "${hash}  ${lib}\n")
endforeach()

if(platform STREQUAL "Linux")
    file(GLOB binaries "${root}/bin/*" "${root}/lib/*.so*")
    list(APPEND binaries ${staged_modules})
    foreach(binary IN LISTS binaries)
        if(IS_SYMLINK "${binary}")
            continue()
        endif()
        get_filename_component(dir "${binary}" DIRECTORY)
        file(RELATIVE_PATH to_lib "${dir}" "${root}/lib")
        execute_process(COMMAND "${patchelf}" --set-rpath "$ORIGIN/${to_lib}" "${binary}"
            COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
elseif(platform STREQUAL "Darwin")
    # BundleUtilities rewrites Mach-O install names, including dlopen modules.
    include(BundleUtilities)
    set(BU_CHMOD_BUNDLE_ITEMS ON)
    function(gp_item_default_embedded_path_override item path_var)
        set(${path_var} "@executable_path/../lib" PARENT_SCOPE)
    endfunction()
    set(extra_items ${staged_modules})
    if(query_loaders)
        get_filename_component(query_name "${query_loaders}" NAME)
        list(APPEND extra_items "${root}/bin/${query_name}")
    endif()
    fixup_bundle("${root}/bin/${exe_name}" "${extra_items}" "${search_dirs};${root}/lib")
endif()

if(platform STREQUAL "Windows")
    configure_file("${templates}/Launch.cmd.in" "${stage}/Launch Ivy.cmd" @ONLY NEWLINE_STYLE CRLF)
else()
    configure_file("${templates}/Launch.sh.in" "${root}/Launch Ivy" @ONLY NEWLINE_STYLE UNIX)
    file(CHMOD "${root}/Launch Ivy" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
        GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    if(platform STREQUAL "Darwin")
        file(MAKE_DIRECTORY "${stage}/Ivy.app/Contents/MacOS")
        file(WRITE "${stage}/Ivy.app/Contents/MacOS/Ivy" "#!/bin/sh\nexec \"$(dirname \"$0\")/../Resources/Launch Ivy\" \"$@\"\n")
        file(CHMOD "${stage}/Ivy.app/Contents/MacOS/Ivy" PERMISSIONS OWNER_READ OWNER_WRITE
            OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
        configure_file("${templates}/Info.plist.in" "${stage}/Ivy.app/Contents/Info.plist" @ONLY)
        find_program(codesign NAMES codesign REQUIRED)
        # Modified Mach-O binaries need fresh ad-hoc signatures on Apple Silicon.
        file(GLOB_RECURSE sign_items "${root}/bin/*" "${root}/lib/*.dylib" "${root}/lib/*.so")
        foreach(item IN LISTS sign_items)
            if(NOT IS_SYMLINK "${item}")
                execute_process(COMMAND "${codesign}" --force --sign - "${item}"
                    COMMAND_ERROR_IS_FATAL ANY)
            endif()
        endforeach()
        execute_process(COMMAND "${codesign}" --force --sign - "${stage}/Ivy.app"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endif()
file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/README.md" DESTINATION "${stage}")
file(MAKE_DIRECTORY "${dist}")
set(archive "${dist}/${name}.zip")
execute_process(COMMAND "@CMAKE_COMMAND@" -E tar cf "${archive}.tmp" --format=zip "${name}"
    WORKING_DIRECTORY "@CMAKE_BINARY_DIR@/bundle-stage" COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${archive}.tmp" "${archive}")
file(SHA256 "${archive}" archive_hash)
file(WRITE "${archive}.sha256" "${archive_hash}  ${name}.zip\n")
message(STATUS "Ready to share: ${archive}")
